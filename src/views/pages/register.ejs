<section class="section">
  <div class="container container--narrow" style="max-width:440px">
    <h1>Create an account</h1>
    <p class="small muted mt-2">So your templates are downloadable forever, from anywhere.</p>

    <% if (errors.length) { %>
      <div class="notice notice--error mt-3"><div><% errors.forEach(function (e) { %><p><%= e %></p><% }); %></div></div>
    <% } %>

    <form class="card mt-4" method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name">Name <span class="muted">(optional)</span></label>
        <input id="name" type="text" name="name" autocomplete="name" value="<%= values.name || '' %>">
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" required minlength="8" autocomplete="new-password">
        <p class="field__hint">At least 8 characters.</p>
      </div>
      <button class="btn btn--accent btn--block" type="submit">Create account</button>
    </form>

    <p class="small muted mt-3 center">Already have one? <a href="/login">Sign in</a>.</p>
  </div>
</section>
