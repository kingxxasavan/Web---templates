<section class="section section--tight">
  <div class="container container--narrow">
    <span class="eyebrow">Domain finder</span>
    <h1 class="mt-1">A name you can actually register</h1>
    <p class="lede mt-2">
      Most generators hand you bare dictionary words that were taken in 1998. This one ranks
      distinctive combinations first, and can check DNS to weed out the obviously-gone.
    </p>

    <form class="card mt-4" id="domain-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid--2" style="gap:16px">
        <div>
          <label for="d-name">Business or project name</label>
          <input id="d-name" name="name" type="text" maxlength="80" value="<%= prefill.name %>" placeholder="Ember Table">
        </div>
        <div>
          <label for="d-category">What is it?</label>
          <select id="d-category" name="category">
            <option value="">General</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.key %>" <%= prefill.category === c.key ? 'selected' : '' %>><%= c.label %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="field mt-3">
        <label for="d-keywords">A few describing words</label>
        <input id="d-keywords" name="keywords" type="text" maxlength="120" value="<%= prefill.keywords %>" placeholder="wood fired pizza leeds">
        <p class="field__hint">Used as fallbacks when the name alone isn't available. Two or three is plenty.</p>
      </div>

      <label class="option" style="max-width:none">
        <input type="checkbox" name="check" id="d-check" checked>
        <span class="option__body">
          <b>Check availability</b>
          <span class="tiny muted">Looks up DNS for each suggestion. Slower, and indicative only — confirm at a registrar before you celebrate.</span>
        </span>
      </label>

      <button class="btn btn--accent btn--block btn--lg mt-3" type="submit">Suggest names</button>
    </form>

    <div id="domain-status" class="mt-3" role="status" aria-live="polite"></div>
    <div id="domain-results" class="mt-3"></div>

    <div class="card mt-5" style="background:var(--surface-2)">
      <h3>Once you've picked one</h3>
      <p class="small muted mt-1">
        Buy it at any registrar — Cloudflare and Porkbun sell at cost, which is usually the cheapest.
        Then <a href="/tutorials/connect-your-domain">point it at your site</a>; that tutorial covers the DNS records step by step.
      </p>
    </div>
  </div>
</section>

<script src="/js/domains.js" defer></script>
