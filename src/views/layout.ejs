<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : store.name %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : store.tagline %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/store.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('partials/masthead') %>

  <% if (flash) { %>
    <div class="container mt-3">
      <div class="notice notice--<%= flash.type === 'error' ? 'error' : 'ok' %>"><%= flash.message %></div>
    </div>
  <% } %>

  <main id="main"><%- body %></main>

  <%- include('partials/footer') %>
  <script src="/js/store.js" defer></script>
</body>
</html>
