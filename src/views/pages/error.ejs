<section class="section">
  <div class="container container--narrow center">
    <span class="eyebrow"><%= status %></span>
    <h1 class="mt-1"><%= title %></h1>
    <p class="lede mt-2" style="margin-inline:auto"><%= message %></p>
    <div class="row mt-4" style="justify-content:center">
      <a class="btn btn--accent" href="/">Back to the store</a>
      <a class="btn btn--ghost" href="/templates">Browse templates</a>
    </div>
    <% if (stack) { %>
      <pre class="mt-5" style="text-align:left"><%= stack %></pre>
    <% } %>
  </div>
</section>
