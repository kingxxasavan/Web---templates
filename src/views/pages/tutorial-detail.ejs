<section class="section section--tight">
  <div class="container container--narrow">
    <p class="small muted"><a href="/tutorials" style="text-decoration:none">&larr; All tutorials</a></p>

    <div class="row mt-3" style="gap:8px">
      <span class="tag tag--accent"><%= tutorial.level %></span>
      <span class="tag"><%= tutorial.minutes %> min read</span>
    </div>

    <h1 class="mt-2"><%= tutorial.title %></h1>
    <p class="lede mt-2"><%= tutorial.blurb %></p>

    <hr class="divider">

    <div class="stack-lg">
      <% tutorial.steps.forEach(function (step, index) { %>
        <section>
          <div class="row" style="gap:12px;align-items:baseline">
            <span class="tag"><%= index + 1 %></span>
            <h2 style="font-size:1.4rem"><%= step.heading %></h2>
          </div>
          <p class="mt-2" style="color:var(--ink-2)"><%= step.body %></p>
          <% if (step.code) { %>
            <pre class="mt-3"><code><%= step.code %></code></pre>
          <% } %>
        </section>
      <% }); %>
    </div>

    <div class="card mt-5" style="background:var(--surface-2)">
      <div class="row row--between">
        <div>
          <h3>Need a template to try this on?</h3>
          <p class="small muted mt-1">Every one is <%= money(store.templatePriceCents) %>, with the full source.</p>
        </div>
        <a class="btn btn--accent" href="/templates">Browse templates</a>
      </div>
    </div>
  </div>
</section>
