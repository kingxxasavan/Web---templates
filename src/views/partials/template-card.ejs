<article class="tile">
  <%- include('thumb', { template }) %>
  <div class="tile__body">
    <div class="row" style="gap:6px">
      <span class="tag tag--accent"><%= template.category %></span>
      <span class="tag"><%= template.style %></span>
      <% if (template.animation !== 'none') { %><span class="tag"><%= template.animation %> motion</span><% } %>
    </div>
    <a class="tile__title" href="/templates/<%= template.slug %>"><%= template.name %></a>
    <p class="small muted"><%= template.tagline %></p>
    <div class="tile__foot">
      <span class="price"><%= money(template.price_cents) %></span>
      <span class="tiny muted"><%= template.pages %> page<%= template.pages === 1 ? '' : 's' %></span>
    </div>
  </div>
</article>
