# ----------------------------------------------------------------- firebase
# Accounts use Firebase Authentication; orders, libraries, reviews and
# messages live in Firestore. Until these are set the store still browses,
# previews and fills carts, and the sign-in page shows a setup notice.
# Full steps: README → "Connecting Firebase".
#
# 1. Web app config (public by design):
#    Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
#
# 2. Service account (SECRET — server only, never prefix with NEXT_PUBLIC_):
#    Project settings → Service accounts → Generate new private key.
#    Paste the whole JSON file on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT=
#    …or instead of FIREBASE_SERVICE_ACCOUNT, the three parts separately:
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------------------- site
# Your live address, used for the sitemap and social previews.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ----------------------------------------------------------------- payments
# Leave unset and checkout runs in simulation mode: orders complete instantly
# and are labelled "simulated", so the whole flow works before Stripe exists.
# Set them and checkout redirects to Stripe; fulfilment happens in the webhook
# (/api/webhook/stripe), so a buyer closing the tab still gets their download.
#
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -------------------------------------------------------------------- email
# Receipts. Password-reset and verification emails are sent by Firebase and
# need nothing here. Without a key, receipts are logged and recorded in the
# `emails` collection, visible in the admin mail log.
#
# RESEND_API_KEY=re_...
# EMAIL_FROM=Foundry <hello@yourdomain.com>

# -------------------------------------------------------------------- admin
# Comma-separated addresses allowed to open /admin. The account must also
# have a verified email (Google sign-in counts; email sign-ups get a
# verification link). Unset means nobody is an admin.
#
# ADMIN_EMAILS=you@example.com
