<section class="section section--tight">
  <div class="container">
    <span class="eyebrow">Catalogue</span>
    <h1 class="mt-1">All templates</h1>
    <p class="lede mt-2">Every one is <%= money(store.templatePriceCents) %>. Buy any three and the three cost <%= money(store.bundle.priceCents) %>.</p>

    <form class="card mt-4" method="get" action="/templates">
      <div class="grid grid--4" style="gap:16px">
        <div>
          <label for="f-q">Search</label>
          <input id="f-q" type="search" name="q" value="<%= filters.q || '' %>" placeholder="e.g. booking, dark, menu">
        </div>
        <div>
          <label for="f-category">Type of site</label>
          <select id="f-category" name="category">
            <option value="">Any</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.key %>" <%= filters.category === c.key ? 'selected' : '' %>><%= c.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="f-style">Style</label>
          <select id="f-style" name="style">
            <option value="">Any</option>
            <% styles.forEach(function (s) { %>
              <option value="<%= s.key %>" <%= filters.style === s.key ? 'selected' : '' %>><%= s.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="f-sort">Sort</label>
          <select id="f-sort" name="sort">
            <option value="featured" <%= filters.sort === 'featured' ? 'selected' : '' %>>Featured</option>
            <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
          </select>
        </div>
      </div>
      <div class="row mt-3">
        <button class="btn btn--accent" type="submit">Apply</button>
        <% if (activeFilters.length) { %>
          <a class="btn btn--quiet" href="/templates">Clear <%= activeFilters.length %> filter<%= activeFilters.length === 1 ? '' : 's' %></a>
        <% } %>
        <span class="spacer"></span>
        <span class="small muted">
          <%= results.length %> of <%= totalCount %> template<%= totalCount === 1 ? '' : 's' %>
        </span>
      </div>
    </form>

    <% if (!results.length) { %>
      <div class="notice notice--warn mt-4">
        <div>
          <strong>Nothing matched those filters.</strong>
          <p class="small mt-1">Try dropping one, or <a href="/find">use the guided finder</a> — it ranks the whole catalogue instead of filtering it down to nothing.</p>
        </div>
      </div>
    <% } else { %>
      <div class="grid grid--3 mt-4">
        <% results.forEach(function (template) { %>
          <%- include('../partials/template-card', { template }) %>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
