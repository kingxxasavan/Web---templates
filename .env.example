# Copy to .env and fill in what you need. Everything has a working default
# except the Stripe keys — without those, checkout runs in simulated mode.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Sign session cookies with a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Stripe. Leave blank to use the built-in simulated checkout.
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/checkout/webhook`
STRIPE_WEBHOOK_SECRET=

SUPPORT_EMAIL=support@fivedollar.store

# Where the SQLite files live.
DATA_DIR=./data
