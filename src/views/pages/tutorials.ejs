<section class="section section--tight">
  <div class="container">
    <span class="eyebrow">Tutorials</span>
    <h1 class="mt-1">From zip to live site</h1>
    <p class="lede mt-2">The parts that usually go unexplained: deploying, DNS, wiring a form, and putting a real Stripe checkout behind a template's cart.</p>

    <div class="grid grid--2 mt-5">
      <% tutorials.forEach(function (tutorial) { %>
        <article class="tile" style="padding:24px">
          <div class="row" style="gap:8px">
            <span class="tag tag--accent"><%= tutorial.level %></span>
            <span class="tag"><%= tutorial.minutes %> min</span>
            <span class="tag"><%= tutorial.steps.length %> steps</span>
          </div>
          <h3 class="mt-2"><a href="/tutorials/<%= tutorial.slug %>" class="tile__title" style="font-size:1.22rem"><%= tutorial.title %></a></h3>
          <p class="small muted mt-1"><%= tutorial.blurb %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>
