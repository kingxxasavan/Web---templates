<section class="section section--tight">
  <div class="container container--narrow">
    <div class="notice notice--ok">
      <div><strong>Payment complete.</strong> Your templates are ready to download.</div>
    </div>

    <div class="card card--raised mt-4">
      <div class="row row--between">
        <div>
          <span class="eyebrow">Receipt</span>
          <h1 class="mt-1" style="font-size:2rem">Order <%= order.reference %></h1>
        </div>
        <span class="price price--lg"><%= money(order.total_cents) %></span>
      </div>

      <table class="table mt-4">
        <tbody>
          <% items.forEach(function (item) { %>
            <tr>
              <td><%= item.name %><% if (item.kind === 'addon') { %> <span class="tag">add-on</span><% } %></td>
              <td class="num"><%= money(item.unit_cents * item.quantity) %></td>
            </tr>
          <% }); %>
          <% if (order.discount_cents > 0) { %>
            <tr style="color:var(--ok)"><td>Bundle discount</td><td class="num">−<%= money(order.discount_cents) %></td></tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr><td>Paid</td><td class="num"><%= money(order.total_cents) %></td></tr>
        </tfoot>
      </table>

      <p class="small muted mt-3">Billed to <b><%= order.email %></b> · <%= order.paid_at %> UTC</p>
    </div>

    <% if (needsPassword) { %>
      <div class="card mt-3">
        <h3>Set a password to keep these</h3>
        <p class="small muted mt-1">
          We created an account for <b><%= order.email %></b> so your downloads have somewhere to live.
          Set a password now and you can come back for them any time, on any machine.
        </p>

        <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
          <div class="notice notice--error mt-2"><div><% errors.forEach(function (e) { %><p><%= e %></p><% }); %></div></div>
        <% } %>

        <form method="post" action="/checkout/claim/<%= order.reference %>" class="mt-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="password">Choose a password</label>
            <input id="password" type="password" name="password" required minlength="8" autocomplete="new-password">
            <p class="field__hint">At least 8 characters.</p>
          </div>
          <button class="btn btn--accent btn--block" type="submit">Save and go to my downloads</button>
        </form>
      </div>
    <% } else { %>
      <div class="card mt-3 center">
        <h3>Your downloads are waiting</h3>
        <p class="small muted mt-1">Every template in this order is in your account, permanently.</p>
        <a class="btn btn--accent mt-3" href="/account">Go to my downloads</a>
        <% if (!signedIn) { %>
          <p class="tiny muted mt-2">Not signed in? <a href="/login">Sign in as <%= order.email %></a>.</p>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
