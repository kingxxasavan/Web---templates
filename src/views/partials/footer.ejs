<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">$5</span>
          <span class="brand__name"><%= store.name %></span>
        </a>
        <p class="muted small mt-2" style="max-width:34ch"><%= store.tagline %> Every template is yours for life, source included, no subscription.</p>
      </div>
      <div>
        <h4>Browse</h4>
        <ul>
          <li><a href="/templates">All templates</a></li>
          <li><a href="/find">Guided finder</a></li>
          <li><a href="/domains">Domain finder</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </div>
      <div>
        <h4>Learn</h4>
        <ul>
          <li><a href="/tutorials/getting-started">Getting started</a></li>
          <li><a href="/tutorials/deploy-your-site">Deploying</a></li>
          <li><a href="/tutorials/take-payments">Taking payments</a></li>
          <li><a href="/tutorials">All tutorials</a></li>
        </ul>
      </div>
      <div>
        <h4>Support</h4>
        <ul>
          <li><a href="/licence">Licence</a></li>
          <li><a href="mailto:<%= store.supportEmail %>">Email us</a></li>
          <li><a href="/account">Your downloads</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__base">
      <span>&copy; <%= new Date().getFullYear() %> <%= store.name %></span>
      <span>
        <% if (!stripeLive) { %>
          <span class="tag tag--warn">Simulated payments — no Stripe key configured</span>
        <% } %>
      </span>
    </div>
  </div>
</footer>
