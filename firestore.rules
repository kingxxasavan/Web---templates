rules_version = '2';

// Every read and write goes through the Next.js server with the Admin SDK,
// which bypasses these rules. Nothing in the browser talks to Firestore, so
// the safe setting is to refuse all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
