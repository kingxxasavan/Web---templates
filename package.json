{
  "name": "fivedollar-store",
  "version": "1.0.0",
  "private": true,
  "description": "The $5 Store \u2014 a full-stack marketplace for high-quality website templates with guided onboarding, Stripe payments and gated downloads.",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test tests/*.test.js",
    "audit:contrast": "node scripts/contrast-audit.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "connect-sqlite3": "^0.9.15",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "express-session": "^1.18.1",
    "morgan": "^1.10.0",
    "stripe": "^17.4.0"
  }
}
